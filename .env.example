# Integración con Brightspace (servicio Python)
# Clave que el servicio Python manda a /internal/v1/* (Authorization: Bearer). Mínimo 32 bytes; vacía = rutas
# internas deshabilitadas. Genérala con: openssl rand -hex 32  (no la subas al repositorio)
INTERNAL_API_KEY=211a19999b6f9ca59c6ba440c252067d97645b62e785472fd091862cbc410174
# Cliente Go → Python. Con PYTHON_BASE_URL vacía Go no llama a Python y todo funciona sin estado Brightspace.
# URL https del servicio Python (ej. https://localhost:8000). http:// se rechaza salvo PYTHON_ALLOW_HTTP=true
PYTHON_BASE_URL=https://localhost:9000
# Clave que Go manda a Python (Authorization: Bearer). Mínimo 32 bytes si hay PYTHON_BASE_URL: openssl rand -hex 32
PYTHON_API_KEY=de7e9f36113515e417cd577f253ade76de72785940af8b3dacc58e5c6108e4a0
# CA en PEM (ej. la de mkcert: $(mkcert -CAROOT)/rootCA.pem) que se suma al almacén del sistema. Nunca se desactiva la verificación
PYTHON_CA_FILE="$(mkcert -CAROOT)/rootCA.pem"
# Solo desarrollo: permite PYTHON_BASE_URL con http:// (las cookies de usuario igual solo viajan por https)
PYTHON_ALLOW_HTTP=false
# Clave AES-256 (32 bytes en base64) para cifrar las cookies de Python guardadas en Go:  openssl rand -base64 32
# Obligatoria si hay TLS, PYTHON_API_KEY o PYTHON_BASE_URL
COOKIE_JAR_KEY=ZFM3nDyskS0qJ4SaFqYlWPwkT6NQDy9RPL88aHo0IyE=
# Cookies de Python que Go captura del navegador al abrir sesión
PYTHON_COOKIE_NAMES=auth_code,access_token,refresh_token,response_time
# Equivalencia de roles de Brightspace (ClasslistRoleName, sin distinguir mayúsculas); LISRoles .../Instructor y .../Learner también valen
D2L_ROLE_MAP=teacher=Profesor,Docente,Instructor,Teacher,Facilitador;student=Estudiante,Student,Alumno
# La lista de clase (roster) se rechaza si desactiva a más de este porcentaje de los inscritos
ROSTER_MAX_DEACTIVATE_PERCENT=30
# HTTPS propio de Go: si ambas existen se usa ListenAndServeTLS y la cookie de sesión es siempre Secure
TLS_CERT_FILE="/home/ago/Desktop/Proyecto de Innovacion TI/V) Proyecto de Innovacion en TI/EduTrace - D2L Connection/localhost.pem"
TLS_KEY_FILE="/home/ago/Desktop/Proyecto de Innovacion TI/V) Proyecto de Innovacion en TI/EduTrace - D2L Connection/localhost-key.pem"
