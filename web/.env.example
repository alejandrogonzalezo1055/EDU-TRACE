# URL base del backend Go (HTTPS en local; el certificado debe ser de confianza para el navegador).
NEXT_PUBLIC_API_URL=https://localhost:8080

# URL del servicio Python (OAuth con Brightspace). El navegador solo NAVEGA a ella
# (/auth/login-url y /auth/logout-url), nunca hace fetch.
NEXT_PUBLIC_AUTH_URL=https://localhost:9000
